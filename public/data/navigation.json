  "groups": {
    "detector": [
      "Detector response & linearity",
      "Learn how light becomes a reported signal and where proportionality can break down. Then examine what gain, saturation and signal compression mean for assay interpretation."
    ],
    "photons": [
      "Photon statistics & read time",
      "Photon collection contributes to measurement variability. Explore when additional reading time helps and when differences between wells set the limit."
    ],
    "background": [
      "Background & blanks",
      "A blank helps define the baseline against which you interpret a sample. Follow what subtraction does to low signals and estimates of variability."
    ],
    "ratios": [
      "Ratio measurements & binding",
      "A ratio combines channels that may respond differently to the experiment. Start with those measurements, then examine tracer behavior and fitted binding results."
    ],
    "variation": [
      "Variation & replication",
      "Repeated readings and separately prepared wells capture different sources of variation. Use that distinction to interpret precision across a plate."
    ],
    "reporters": [
      "Light-producing assays",
      "Connect the biological event to the reactions that generate light. These guides explain the controls that help you interpret a change in signal."
    ],
    "binding": [
      "Binding & proximity assays",
      "Choose a readout that fits the interaction you want to study. Explore tracer design, proximity measurements and the conditions that affect apparent binding."
    ],
    "handling": [
      "Plate handling & assay conditions",
      "Plate layout, timing and temperature influence what reaches the detector. Explore practical ways to understand those effects in microplate experiments."
    ],
    "optics": [
      "Optical settings & signal interpretation",
      "Reader settings influence which light is collected and how it is reported. Use these articles to connect an observation to the measurement conditions."
    ],
    "chemistry": [
      "Detection chemistry & interference",
      "Detection reagents can respond to more than the intended biological event. Explore controls and observations that help explain a change in signal."
    ],
    "formats": [
      "Assay method comparisons",
      "Different methods can report different aspects of the same sample. Compare what each format measures before choosing a readout."
    ],
    "equipment": [
      "Instruments & screening workflows",
      "An instrument choice depends on the measurements and workflow it needs to support. Compare practical capabilities alongside the conditions behind them."
    ]
  },
